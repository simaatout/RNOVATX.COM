---
import { Image } from 'astro:assets';
import type { Person } from '../data/team';
import type { Lang } from '../data/site';
import { l } from '../i18n';

interface Props { person: Person; lang: Lang; size?: 'lg' | 'md' }
const { person, lang, size = 'md' } = Astro.props;
---
<article class:list={['tc', `tc--${size}`]} data-reveal>
  <div class="tc__photo">
    {person.photo ? (
      <Image
        src={person.photo}
        alt={lang === 'fr' ? `Portrait de ${person.name}` : `Portrait of ${person.name}`}
        widths={[240, 360, 480]}
        sizes="(min-width: 900px) 240px, 45vw"
        loading="lazy"
        style={person.photoPosition ? `object-position:${person.photoPosition}` : undefined}
      />
    ) : (
      <span class="tc__initials" aria-hidden="true">{person.initials}</span>
    )}
  </div>
  <div class="tc__body">
    <h3 class="tc__name">{person.name}{person.credentials && <span class="tc__cred">, {person.credentials}</span>}</h3>
    <p class="tc__title">{l(person.title, lang)}</p>
    <p class="tc__bio">{l(person.bio, lang)}</p>
  </div>
</article>

<style>
  .tc { display: grid; gap: 20px; align-content: start; }
  .tc--lg { grid-template-columns: 1fr; }
  @media (min-width: 640px) { .tc--lg { grid-template-columns: 200px 1fr; gap: 28px; } }
  .tc__photo {
    position: relative; aspect-ratio: 4 / 5; border-radius: 20px; overflow: hidden; width: 100%; max-width: 240px;
    background: linear-gradient(160deg, #eef1fb, #e6e0fb);
    padding: 3px;
  }
  /* Unified treatment: same crop, soft brand-gradient border, neutral backdrop */
  .tc__photo::before { content: ''; position: absolute; inset: 0; border-radius: 20px; padding: 2px; background: var(--grad-brand); opacity: 0.55;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; z-index: 1; }
  .tc__photo :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 17px; filter: saturate(0.92) contrast(1.02); }
  .tc__initials {
    display: grid; place-items: center; width: 100%; height: 100%; border-radius: 17px;
    background:
      radial-gradient(80% 60% at 30% 20%, rgba(141, 175, 253, 0.55), transparent 70%),
      radial-gradient(70% 60% at 90% 100%, rgba(192, 46, 253, 0.28), transparent 70%),
      linear-gradient(160deg, #0e1860, #2a1466);
    color: #fff; font-weight: 700; font-size: clamp(1.8rem, 3vw, 2.4rem); letter-spacing: 0.06em;
  }
  .tc__body { display: grid; gap: 6px; align-content: start; }
  .tc__name { font-size: 1.2rem; letter-spacing: -0.01em; }
  .tc__cred { font-weight: 500; color: var(--muted); }
  .tc__title { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--violet-600); }
  .tc__bio { margin-top: 6px; color: var(--ink-2); font-size: 0.96rem; }
</style>
