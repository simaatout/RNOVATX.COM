---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, href, type RouteKey } from '../i18n';
import type { Lang } from '../data/site';

interface Props { lang: Lang; route: RouteKey }
const { lang, route } = Astro.props;
const d = t(lang);
const items: { key: RouteKey; label: string; sub?: boolean }[] = [
  { key: 'home', label: d.nav.home },
  { key: 'about', label: d.nav.about },
  { key: 'science', label: d.nav.science },
  { key: 'pipeline', label: d.nav.pipeline },
  { key: 'research', label: d.nav.researchOverview },
  { key: 'publications', label: d.nav.publications, sub: true },
  { key: 'patent', label: d.nav.patent, sub: true },
  { key: 'contact', label: d.nav.contact },
];
---
<div class="mnav" id="mobile-nav" role="dialog" aria-modal="true" aria-label={d.nav.menu} hidden data-mobile-nav>
  <div class="mnav__top container">
    <Logo id="mnav" />
    <button class="mnav__close" type="button" data-menu-close>
      <span class="sr-only">{d.nav.close}</span>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 3l12 12M15 3 3 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </button>
  </div>
  <nav class="container mnav__body" aria-label={d.nav.primary}>
    <ul>
      {items.map((item) => (
        <li class:list={{ 'is-sub': item.sub }}>
          <a href={href(item.key, lang)} aria-current={route === item.key ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
    <div class="mnav__footer">
      <LanguageSwitcher lang={lang} route={route} variant="full" />
      <a class="btn btn--primary" href={href('contact', lang)}>{d.nav.cta}</a>
    </div>
  </nav>
</div>

<style>
  .mnav { position: fixed; inset: 0; z-index: 150; background: #fff; overflow-y: auto; display: flex; flex-direction: column; }
  .mnav[hidden] { display: none; }
  .mnav__top { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .mnav__close { width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--line-strong); background: #fff; display: grid; place-items: center; cursor: pointer; }
  .mnav__body { padding-block: 16px 40px; display: flex; flex-direction: column; gap: 32px; flex: 1; }
  .mnav__body ul { list-style: none; }
  .mnav__body li a {
    display: block; padding: 14px 0; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em;
    color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line);
  }
  .mnav__body li.is-sub a { font-size: 1.1rem; font-weight: 600; padding-left: 20px; color: var(--ink-2); }
  .mnav__body li a[aria-current] { color: var(--violet-600); }
  .mnav__footer { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; margin-top: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .mnav:not([hidden]) { animation: mnav-in 0.28s var(--ease); }
    @keyframes mnav-in { from { opacity: 0; transform: translateY(-8px); } }
  }
</style>
