---
import { Image } from 'astro:assets';
import LanguageSwitcher from './LanguageSwitcher.astro';
import logo from '../assets/brand/rnova-logo.png';
import { t, href, type RouteKey } from '../i18n';
import { site, type Lang } from '../data/site';

interface Props { lang: Lang; route: RouteKey }
const { lang, route } = Astro.props;
const d = t(lang);
const company: { key: RouteKey; label: string }[] = [
  { key: 'home', label: d.nav.home },
  { key: 'about', label: d.nav.about },
  { key: 'science', label: d.nav.science },
  { key: 'pipeline', label: d.nav.pipeline },
  { key: 'contact', label: d.nav.contact },
];
const research: { key: RouteKey; label: string }[] = [
  { key: 'research', label: d.nav.researchOverview },
  { key: 'publications', label: d.nav.publications },
  { key: 'patent', label: d.nav.patent },
];
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Image src={logo} alt="RNOVA Therapeutics" width={260} widths={[260, 520]} sizes="260px" class="footer__logo" loading="lazy" />
        <p class="footer__statement">{d.footer.statement}</p>
      </div>
      <nav class="footer__col" aria-label={d.footer.navHeading}>
        <h2 class="footer__h">{d.footer.navHeading}</h2>
        <ul>{company.map((i) => <li><a href={href(i.key, lang)}>{i.label}</a></li>)}</ul>
      </nav>
      <nav class="footer__col" aria-label={d.footer.researchHeading}>
        <h2 class="footer__h">{d.footer.researchHeading}</h2>
        <ul>{research.map((i) => <li><a href={href(i.key, lang)}>{i.label}</a></li>)}</ul>
      </nav>
      <div class="footer__col">
        <h2 class="footer__h">{d.footer.contactHeading}</h2>
        <ul>
          <li>{site.city[lang]}</li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="footer__social" href={site.linkedin} target="_blank" rel="noopener noreferrer"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>LinkedIn<span class="sr-only">{lang === 'fr' ? ' (s’ouvre dans un nouvel onglet)' : ' (opens in a new tab)'}</span></a></li>
          <li class="footer__lang"><LanguageSwitcher lang={lang} route={route} variant="full" /></li>
        </ul>
      </div>
    </div>
    <div class="divider-strand footer__rule" aria-hidden="true"></div>
    <div class="footer__bottom">
      <p class="footer__disclaimer">{d.footer.disclaimer}</p>
      <p class="footer__copy">© {site.copyrightYear} RNOVA Tx (RNOVA Therapeutics). {d.footer.rights}</p>
    </div>
  </div>
</footer>

<style>
  .footer { background: #fff; color: var(--ink-2); padding-block: 72px 40px; font-size: 0.95rem; border-top: 1px solid var(--line); }
  .footer a { color: var(--ink); text-decoration: none; }
  .footer a:hover { color: var(--violet-600); text-decoration: underline; }
  .footer__top { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .footer__top { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .footer__top { grid-template-columns: 1.6fr 1fr 1fr 1.2fr; } }
  .footer__logo { width: 230px; margin: -22px 0 0 -14px; }
  .footer__statement { margin-top: 4px; max-width: 30ch; color: var(--ink); font-weight: 650; line-height: 1.4; }
  .footer__h { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
  .footer__col ul { list-style: none; display: grid; gap: 10px; }
  .footer__social { display: inline-flex; align-items: center; gap: 8px; }
  .footer__social svg { color: #0a66c2; }
  .footer__lang { margin-top: 6px; color: var(--ink); }
  .footer__rule { margin-block: 48px 28px; }
  .footer__bottom { display: grid; gap: 12px; font-size: 0.85rem; }
  @media (min-width: 900px) { .footer__bottom { grid-template-columns: 1fr auto; align-items: end; gap: 40px; } }
  .footer__disclaimer { max-width: 80ch; color: var(--muted); }
  .footer__copy { color: var(--muted); white-space: nowrap; }
</style>
