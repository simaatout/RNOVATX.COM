---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MicrogliaDiagram from '../components/MicrogliaDiagram.astro';
import TranslationDiagram from '../components/TranslationDiagram.astro';
import TechnologyCard from '../components/TechnologyCard.astro';
import PipelineChart from '../components/PipelineChart.astro';
import DevelopmentPath from '../components/DevelopmentPath.astro';
import PartnershipCTA from '../components/PartnershipCTA.astro';
import ArrowLink from '../components/ArrowLink.astro';
import RnaStrand from '../components/RnaStrand.astro';
import { t, href } from '../i18n';
import type { Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
const pubAnchors = ['boutej-2017', 'barreto-nunez-2024', 'rahimian-2024'];
const ringDots = [0, 1, 2, 3, 4, 5].map((i) => { const a = (i * Math.PI * 2) / 6 + 0.95; return { x: 200 + Math.cos(a) * 138, y: 200 + Math.sin(a) * 138, fill: i % 2 ? '#b02ef0' : '#3a3dfc' }; });
const outerDots = [0, 1, 2, 3].map((i) => { const a = (i * Math.PI * 2) / 4 + 1.1; return { x: 200 + Math.cos(a) * 186, y: 200 + Math.sin(a) * 186 }; });
---
<BaseLayout lang={lang} route="home" title={d.meta.home.title} description={d.meta.home.description} overDarkHeader>
  <Hero lang={lang} />

  <!-- 01 The challenge -->
  <section class="section" aria-labelledby="s01">
    <div class="container grid-2 grid-2--wide-right">
      <div class="stack" style="--stack: 1.5rem">
        <SectionHeading index={h.challenge.index} kicker={h.challenge.kicker} title={h.challenge.title} id="s01" />
        <div class="prose" data-reveal data-reveal-delay="1">
          {h.challenge.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <MicrogliaDiagram lang={lang} />
    </div>
  </section>

  <!-- 02 The translational brake -->
  <section class="section section--soft" aria-labelledby="s02">
    <div class="container">
      <SectionHeading index={h.brake.index} kicker={h.brake.kicker} title={h.brake.title} id="s02">
        <p class="lede" data-reveal data-reveal-delay="1">{h.brake.intro}</p>
      </SectionHeading>
      <div class="home-brake">
        <TranslationDiagram lang={lang} />
      </div>
      <p class="cite home-brake__cite">
        <span class="cite__label">{d.common.sources}</span>
        <span>{h.brake.cite}</span>
        <a href={href('publications', lang)}>{d.common.publishedScience} →</a>
      </p>
    </div>
  </section>

  <!-- 03 The RNOVA approach -->
  <section class="section section--dark home-approach" aria-labelledby="s03">
    <RnaStrand class="home-approach__strand" />
    <div class="container">
      <div class="grid-2 grid-2--wide-left">
        <SectionHeading index={h.approach.index} kicker={h.approach.kicker} titleLines={h.approach.titleLines} id="s03" />
        <p class="lede" data-reveal data-reveal-delay="1">{h.approach.body}</p>
      </div>
      <ol class="approach">
        {h.approach.points.map((pt, i) => (
          <li class="approach__item" data-reveal data-reveal-delay={String(i % 4)}>
            <span class="approach__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="approach__h">{pt.title}</h3>
            <p>{pt.text}</p>
          </li>
        ))}
      </ol>
      <p class="approach__note">{h.approach.note}</p>
    </div>
  </section>

  <!-- 04 Targeted RNA therapeutics -->
  <section class="section" aria-labelledby="s04">
    <div class="container">
      <SectionHeading index={h.tech.index} kicker={h.tech.kicker} title={h.tech.title} id="s04" />
      <div class="tech-grid">
        <TechnologyCard variant="aso" {...h.tech.pillars[0]} />
        <TechnologyCard variant="targeted" {...h.tech.pillars[1]} />
      </div>
    </div>
  </section>

  <!-- 05 Therapeutic reach -->
  <section class="section section--soft" aria-labelledby="s05">
    <div class="container grid-2">
      <div class="stack" style="--stack: 1.5rem">
        <SectionHeading index={h.reach.index} kicker={h.reach.kicker} title={h.reach.title} id="s05" />
        <p class="lede" data-reveal>{h.reach.body}</p>
        <div class="reach-cards">
          <article class="reach-card reach-card--lead" data-reveal>
            <span class="tag tag--brand">{h.reach.lead.tag}</span>
            <h3 class="reach-card__name">{h.reach.lead.name}</h3>
            <p>{h.reach.lead.text}</p>
          </article>
          {h.reach.advancement.map((e, i) => (
            <article class="reach-card" data-reveal data-reveal-delay={String(i + 1)}>
              <span class="tag tag--violet">{e.tag}</span>
              <h3 class="reach-card__name reach-card__name--sm">{e.name}</h3>
              <p>{e.text}</p>
            </article>
          ))}
        </div>
        <p class="small muted">{h.reach.footnote}</p>
      </div>
      <figure class="reach-viz" data-reveal aria-hidden="true">
        <svg viewBox="0 0 400 400">
          <defs>
            <radialGradient id="reach-core" cx="0.4" cy="0.35" r="0.8"><stop offset="0" stop-color="#8dafFD" /><stop offset="1" stop-color="#3a3dfc" /></radialGradient>
            <linearGradient id="reach-ring" x1="0" x2="1"><stop offset="0" stop-color="#3a3dfc" /><stop offset="1" stop-color="#c02efd" /></linearGradient>
          </defs>
          <circle cx="200" cy="200" r="186" fill="none" stroke="#c8cee3" stroke-width="1.5" stroke-dasharray="2 8" />
          <circle cx="200" cy="200" r="138" fill="rgba(126,27,241,0.05)" stroke="url(#reach-ring)" stroke-width="2" stroke-dasharray="8 8" />
          <circle cx="200" cy="200" r="78" fill="url(#reach-core)" />
          <text x="200" y="192" text-anchor="middle" fill="#fff" font-weight="800" font-size="34" letter-spacing="1">{lang === 'fr' ? 'SLA' : 'ALS'}</text>
          <text x="200" y="220" text-anchor="middle" fill="#e6ebff" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="1">{h.reach.lead.tag.toUpperCase()}</text>
          <text x="200" y="86" text-anchor="middle" fill="#6a17d6" font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="2">{h.reach.advancement[0].tag.toUpperCase()}</text>
          {ringDots.map((p) => <circle cx={p.x} cy={p.y} r="7" fill={p.fill} opacity="0.8" />)}
          {outerDots.map((p) => <circle cx={p.x} cy={p.y} r="5" fill="none" stroke="#9aa1bf" stroke-width="1.5" />)}
        </svg>
      </figure>
    </div>
  </section>

  <!-- 06 Built on published science -->
  <section class="section" aria-labelledby="s06">
    <div class="container">
      <SectionHeading index={h.published.index} kicker={h.published.kicker} title={h.published.title} id="s06" />
      <ol class="milestones">
        {h.published.milestones.map((m, i) => (
          <li data-reveal data-reveal-delay={String(i)}>
            <a class="milestone card card--lift" href={href('publications', lang, `#${pubAnchors[i]}`)}>
              <span class="milestone__year">{m.year}</span>
              <span class="milestone__journal">{m.journal}</span>
              <span class="milestone__text">{m.text}</span>
              <span class="milestone__more" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
      <ArrowLink href={href('publications', lang)} class="milestones__all">{d.common.publishedScience}</ArrowLink>
    </div>
  </section>

  <!-- 07 Pipeline preview -->
  <section class="section section--soft" aria-labelledby="s07">
    <div class="container stack" style="--stack: 2.5rem">
      <div class="home-row">
        <SectionHeading index={h.pipelinePreview.index} kicker={h.pipelinePreview.kicker} title={h.pipelinePreview.title} id="s07" />
        <ArrowLink href={href('pipeline', lang)}>{h.pipelinePreview.cta}</ArrowLink>
      </div>
      <PipelineChart lang={lang} compact />
    </div>
  </section>

  <!-- 08 From discovery toward translation -->
  <section class="section" aria-labelledby="s08">
    <div class="container stack" style="--stack: 3rem">
      <SectionHeading index={h.path.index} kicker={h.path.kicker} title={h.path.title} id="s08" />
      <DevelopmentPath lang={lang} />
    </div>
  </section>

  <!-- 09 Partnership -->
  <PartnershipCTA lang={lang} />
</BaseLayout>

<style>
  .home-brake { margin-top: clamp(40px, 5vw, 64px); }
  .home-brake__cite { margin-top: 24px; }

  .home-approach { overflow: hidden; }
  .home-approach :global(.home-approach__strand) { position: absolute; left: -10%; bottom: 40px; width: 120%; opacity: 0.25; pointer-events: none; }
  .approach { list-style: none; display: grid; gap: 16px; margin-top: clamp(40px, 5vw, 72px); position: relative; }
  @media (min-width: 720px) { .approach { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .approach { grid-template-columns: repeat(4, 1fr); } }
  .approach__item {
    padding: 24px; border-radius: var(--radius); background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1); display: grid; gap: 10px; align-content: start;
  }
  .approach__n { font-family: var(--font-mono); font-size: 0.8rem; color: #c9b6ff; }
  .approach__h { font-size: 1.12rem; }
  .approach__item p { color: #c3caf0; font-size: 0.95rem; }
  .approach__note { margin-top: 28px; font-size: 0.85rem; color: #8f97c7; position: relative; }

  .tech-grid { display: grid; gap: 20px; margin-top: clamp(36px, 4vw, 56px); }
  @media (min-width: 900px) { .tech-grid { grid-template-columns: 1fr 1fr; } }

  .reach-cards { display: grid; gap: 12px; }
  .reach-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; display: grid; gap: 8px; }
  .reach-card .tag { justify-self: start; }
  .reach-card p { color: var(--ink-2); font-size: 0.95rem; }
  .reach-card--lead { border-color: rgba(58, 61, 252, 0.35); box-shadow: 0 0 0 4px rgba(58, 61, 252, 0.06); }
  .reach-card__name { font-size: 2rem; letter-spacing: -0.02em; }
  .reach-card__name--sm { font-size: 1.15rem; }
  .reach-viz { margin: 0; max-width: 460px; justify-self: center; width: 100%; }
  @media (max-width: 899px) { .reach-viz { max-width: 320px; order: -1; } }

  .milestones { list-style: none; display: grid; gap: 16px; margin-block: clamp(36px, 4vw, 56px) 32px; }
  @media (min-width: 900px) { .milestones { grid-template-columns: repeat(3, 1fr); } }
  .milestones li { display: flex; }
  .milestone { display: grid; gap: 10px; align-content: start; text-decoration: none; color: inherit; position: relative; width: 100%; }
  .milestone:hover { color: inherit; }
  .milestone__year { font-size: 2.6rem; font-weight: 750; letter-spacing: -0.03em; line-height: 1; }
  .milestone__journal { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--violet-600); }
  .milestone__text { color: var(--ink-2); font-size: 0.97rem; }
  .milestone__more { position: absolute; top: 24px; right: 24px; color: var(--muted); transition: transform 0.25s var(--ease), color 0.25s; }
  .milestone:hover .milestone__more { transform: translateX(4px); color: var(--violet-600); }

  .home-row { display: flex; flex-wrap: wrap; gap: 20px; align-items: end; justify-content: space-between; }
</style>
