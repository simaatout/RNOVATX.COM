---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'light' | 'ghost-light';
  size?: 'sm' | 'md';
  class?: string;
}
const { href, variant = 'primary', size = 'md', class: className } = Astro.props;
---
<a class:list={['btn', `btn--${variant}`, { 'btn--sm': size === 'sm' }, className]} href={href}>
  <slot />
  <svg class="btn__arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
</a>
